generator sguClient {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/sgu/client"
}

datasource sguDb {
  provider = "mysql"
  url      = env("SGU_DATABASE_URL")
}

model tblUsuarios {
  cpID          BigInt  @id @default(autoincrement())
  cpRF          String? @sguDb.VarChar(7)
  cpNome        String? @sguDb.VarChar(250)
  cpVinculo     String? @sguDb.VarChar(1)
  cpnomecargo2  String? @sguDb.VarChar(150)
  cpRef         String? @sguDb.VarChar(6)
  cpUnid        String? @sguDb.VarChar(15)
  cpnomesetor2  String? @sguDb.VarChar(250)
  cpPermissao   String? @sguDb.VarChar(3)
  cpImprimir    String? @sguDb.VarChar(5)
  cpUltimaCarga String? @sguDb.VarChar(3)
  cpOBS         String? @sguDb.VarChar(300)
}
